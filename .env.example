# 运行环境。生产部署请保持为 production，应用会据此启用安全 Cookie 和密钥检查。
NODE_ENV=production

# 仅用于开发环境预览的本地管理员账号。必须同时设置 NODE_ENV=development 才会生效。
MOD_AUTH_DEV_ACCOUNT_ENABLED=false
MOD_AUTH_DEV_ACCOUNT_NAME=本地管理员
MOD_AUTH_DEV_ACCOUNT_USERNAME=local-admin
MOD_AUTH_DEV_ACCOUNT_EMAIL=local-admin@localhost.test

# Docker Compose 在宿主机上的监听地址。生产环境建议只绑定回环地址，
# 再由同一台机器上的 Nginx/Caddy 负责 HTTPS 和公网访问。
WEB_BIND_HOST=127.0.0.1

# Docker Compose 在宿主机映射的端口；容器内部端口固定为 3100。
WEB_PORT=3100

# 对外公开的网站根地址。生产环境必须填写 HTTPS 完整地址，
# 用于 OIDC 回调、邮件说明和反向代理部署时生成正确链接。
WEB_URL=https://mods.vintagestory.top

# Discourse OIDC 提供商地址。
OIDC_ISSUER=https://connect.vintagestory.top

# 在 OIDC 提供商后台创建的客户端 ID。
OIDC_CLIENT_ID=

# OIDC 客户端密钥。请勿提交到 Git 或写入前端代码。
OIDC_CLIENT_SECRET=

# 被视为模组网站管理员的社区 OIDC 群组名称；仅社区登录用户会检查此群组。
# 需要 OIDC 提供商在 UserInfo 中返回 groups 字段，默认群组为“管理员”。
COMMUNITY_ADMIN_GROUP=管理员

# OIDC 回调地址；留空时自动使用 WEB_URL 的 /api/auth/community/callback。
# 使用反向代理时，建议填写对外的 HTTPS 完整地址，并与 WEB_URL 同源。
OIDC_REDIRECT_URI=

# 服务端会随机生成一次性邮箱验证码，并通过以下 SMTP 配置发送。
# SMTP 邮件服务器地址，例如 smtp.example.com。
SMTP_HOST=

# SMTP 端口。常见提交端口为 587，465 通常配合 SMTPS。
SMTP_PORT=587

# 是否使用 TLS 直连。留空时 465 端口自动启用，587 端口默认使用 STARTTLS。
SMTP_SECURE=false

# SMTP 登录用户名；无认证中继可留空，但必须与 SMTP_PASSWORD 同时留空。
SMTP_USER=

# SMTP 登录密码。请勿提交到 Git 或写入前端代码。
SMTP_PASSWORD=

# 发件人地址，例如 "VSCN Mod DB <noreply@example.com>"。
SMTP_FROM=

# 用于签名绑定凭据和会话 Cookie 的随机密钥，至少 32 个字符。
# 生成示例：openssl rand -base64 48
# 生产环境必须填写真实随机值，不能使用示例文本或留空。
MOD_AUTH_SESSION_SECRET=

# 账号 JSON 数据在容器内的目录。Compose 默认将其挂载到持久化卷。
MOD_AUTH_DATA_DIR=/app/data

# PostgreSQL 容器配置。宿主机默认映射到 5433，避免占用已有数据库的 5432。
POSTGRES_DB=vscn_mod_db
POSTGRES_USER=vscn
POSTGRES_PASSWORD=vscn_dev_password
POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_PORT=5433

# PostgreSQL 业务数据库。Docker Compose 中必须使用服务名 db 和容器端口 5432，
# 不能使用 localhost；localhost 在 Web 容器中表示 Web 容器自身。
DATABASE_URL=postgresql://vscn:vscn_dev_password@db:5432/vscn_mod_db?schema=public
# 可选：仅供 Compose 迁移服务使用的数据库地址。使用内置 db 服务时留空，
# 迁移服务会自动使用内部的 db 主机名。
MIGRATION_DATABASE_URL=

# 可选的开发数据初始化开关（生产环境绝不能启用）。
SEED_DEV_DATA=false

# 对象存储。开发环境可设置 STORAGE_DRIVER=local；生产环境应使用
# S3 兼容服务，并将存储桶设置为私有。
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/objects
# 通用 S3/MinIO/R2 使用 s3，多吉云对象存储使用 dogecloud。
STORAGE_S3_PROVIDER=s3
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=auto
STORAGE_S3_FORCE_PATH_STYLE=false
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_SIGNED_URL_TTL=300

# 多吉云对象存储。STORAGE_S3_PROVIDER=dogecloud 时，服务端会使用以下长期
# 控制台凭据换取临时 S3 凭据。返回的 S3 存储桶和 endpoint 会自动发现，
# 且不会发送给浏览器用户。
# STORAGE_S3_BUCKET / STORAGE_S3_ACCESS_KEY / STORAGE_S3_SECRET_KEY 也作为
# 兼容旧配置的别名保留，但建议使用下面的专用变量名。
STORAGE_DOGECLOUD_API_BASE=https://api.dogecloud.com
STORAGE_DOGECLOUD_BUCKET=
STORAGE_DOGECLOUD_ACCESS_KEY=
STORAGE_DOGECLOUD_SECRET_KEY=

# VintageStory 官方账号认证接口。
VS_AUTH3_LOGIN_URL=https://auth3.vintagestory.at/v2/gamelogin

# 获取 VintageStory 最新测试版本号的接口。
VS_API_LATEST_UNSTABLE_URL=https://api.vintagestory.at/latestunstable.txt
