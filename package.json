{
  "name": "vscn-mod-db-home",
  "version": "0.1.0",
  "private": true,
  "description": "VSCN Mod DB homepage",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:import-legacy": "tsx scripts/import-legacy-accounts.ts",
    "test": "vitest run",
    "test:api": "vitest run tests/api.integration.test.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1105.0",
    "@aws-sdk/s3-request-presigner": "^3.1105.0",
    "@prisma/client": "^6.19.0",
    "@tinymce/tinymce-react": "^6.3.0",
    "echarts": "^6.1.0",
    "lucide-react": "^1.28.0",
    "next": "16.2.6",
    "nodemailer": "^9.0.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sanitize-html": "^2.17.6",
    "tinymce": "^8.8.2",
    "tinymce-i18n": "^26.8.2",
    "zod": "^4.4.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.3.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/sanitize-html": "^2.16.1",
    "prisma": "^6.19.0",
    "tsx": "^4.23.9",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  }
}
